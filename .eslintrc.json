{
  "env": {
    "browser": true,
    "es2021": true,
    "node": true,
    "jest": true
  },
  "extends": "eslint:recommended",
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "globals": {
    "THREE": "readonly",
    "bkcore": "readonly",
    "GarageRenderer": "readonly"
  },
  "rules": {
    "no-unused-vars": ["error", { "varsIgnorePattern": "^expect$" }],
    "no-inner-declarations": "off",
    "no-empty": "warn"
  }
}
